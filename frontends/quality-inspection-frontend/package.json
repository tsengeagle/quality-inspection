{
  "name": "quality-inspection-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:standalone": "ng serve --configuration=standalone",
    "demo:launch": "pwsh -NoLogo -NoProfile -File ..\\..\\scripts\\demo\\launch-demo.ps1 -Action Start",
    "demo:launch:preflight": "pwsh -NoLogo -NoProfile -File ..\\..\\scripts\\demo\\launch-demo.ps1 -Action Start -RunPreflight",
    "demo:stop": "pwsh -NoLogo -NoProfile -File ..\\..\\scripts\\demo\\launch-demo.ps1 -Action Stop",
    "demo:status": "pwsh -NoLogo -NoProfile -File ..\\..\\scripts\\demo\\launch-demo.ps1 -Action Status",
    "demo:restart": "pwsh -NoLogo -NoProfile -File ..\\..\\scripts\\demo\\launch-demo.ps1 -Action Restart",
    "demo:preflight": "set QI_PLAYWRIGHT_FLOW=preflight&& playwright test e2e/src/demo-preflight.e2e.spec.ts --workers=1",
    "demo:run": "set QI_PLAYWRIGHT_FLOW=demo&& playwright test e2e/src/demo-showcase.e2e.spec.ts --headed --workers=1",
    "demo:e2e": "set QI_PLAYWRIGHT_FLOW=e2e&& playwright test e2e/src/live-standalone.e2e.spec.ts --workers=1",
    "prototype:install": "npm install --prefix ./prototype-react",
    "prototype:dev": "npm run dev --prefix ./prototype-react",
    "prototype:build": "npm run build --prefix ./prototype-react",
    "build": "ng build",
    "build:production": "ng build --configuration=production",
    "typecheck": "ng build --configuration=development",
    "test": "ng test",
    "test:unit": "ng test",
    "test:ci": "ng test --no-watch --code-coverage",
    "test:unit:ci": "ng test --no-watch --code-coverage",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "test:e2e:headed": "playwright test --headed",
    "verify:frontend": "npm run typecheck && npm run test:unit:ci",
    "lint": "echo 'lint not yet configured'"
  },
  "dependencies": {
    "@angular/animations": "^14.3.0",
    "@angular/common": "^14.3.0",
    "@angular/compiler": "^14.3.0",
    "@angular/core": "^14.3.0",
    "@angular/forms": "^14.3.0",
    "@angular/platform-browser": "^14.3.0",
    "@angular/platform-browser-dynamic": "^14.3.0",
    "@angular/router": "^14.3.0",
    "@angular-architects/module-federation": "^14.3.0",
    "@ngrx/store": "^14.3.0",
    "@ngrx/effects": "^14.3.0",
    "@ngrx/store-devtools": "^14.3.0",
    "portal51-lib": "0.0.16",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.0",
    "@angular/cli": "^14.2.0",
    "@angular/compiler-cli": "^14.3.0",
    "@playwright/test": "^1.40.0",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^16.11.0",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~4.7.2"
  }
}
