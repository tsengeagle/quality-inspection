2" height="90" /></mxCell><mxCell id="hcaapi-50" value="&lt;b&gt;⑥ 確認檔案存在&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;檔案伺服器&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="634" width="172" height="90" /></mxCell><mxCell id="hcaapi-51" value="&lt;b&gt;⑦ 工作清單已標為已簽〔W4〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;成功點；寫入資料庫&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="1182" y="634" width="172" height="90" /></mxCell><mxCell id="hcaapi-52" value="&lt;b&gt;⑧ PDF 搬移&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;刪原檔、傳到新位置&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1374" y="634" width="172" height="90" /></mxCell><mxCell id="hcaapi-53" value="&lt;b&gt;⑨ 簽章登記已完成&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;C；寫入資料庫&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="1566" y="634" width="172" height="90" /></mxCell><mxCell id="hcaapi-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-45" target="hcaapi-46"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-46" target="hcaapi-47"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-47" target="hcaapi-48"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-48" target="hcaapi-49"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-49" target="hcaapi-50"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-50" target="hcaapi-51"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-51" target="hcaapi-52"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-52" target="hcaapi-53"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-62" value="&lt;b&gt;└──── 鎖內：①②③ ────┘&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="736" width="556" height="42" /></mxCell><mxCell id="hcaapi-63" value="&lt;b&gt;└──────────── 鎖外：④ 到 ⑨ ────────────┘&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="606" y="736" width="1132" height="42" /></mxCell><mxCell id="hcaapi-64" value="&lt;b&gt;兩個各自獨立的狀態欄位〔W7〕&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="806" width="1700" height="30" /></mxCell><mxCell id="hcaapi-65" value="&lt;b&gt;簽章登記&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;emr_general_sheet_sign_status。程式定義 Pending、Locked、Completed、Failed、Expired；HCAAPI 只寫 L、C、E，失敗時不寫 Failed&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="842" width="300" height="126" /></mxCell><mxCell id="hcaapi-66" value="&lt;b&gt;鎖定之前&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;由其他程式建立；推定為 Pending&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="842" width="260" height="126" /></mxCell><mxCell id="hcaapi-67" value="&lt;b&gt;① 簽章登記已鎖定&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="842" width="260" height="126" /></mxCell><mxCell id="hcaapi-68" value="&lt;b&gt;鎖定（L）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="955" y="842" width="260" height="126" /></mxCell><mxCell id="hcaapi-69" value="&lt;b&gt;⑨ 簽章登記已完成&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="842" width="260" height="126" /></mxCell><mxCell id="hcaapi-70" value="&lt;b&gt;完成（C）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1545" y="842" width="260" height="126" /></mxCell><mxCell id="hcaapi-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-65" target="hcaapi-66"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-66" target="hcaapi-67"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-67" target="hcaapi-68"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-68" target="hcaapi-69"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-69" target="hcaapi-70"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-76" value="&lt;b&gt;已確認｜L 是防止重複簽章的鎖定標記（讀程式所得）〔W12〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;同一份文件若已有另一筆登記是鎖定或完成，① 會把自己那筆改成 Expired 並回報失敗。同一筆登記停在 L 時可以再次鎖定&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="982" width="860" height="66" /></mxCell><mxCell id="hcaapi-77" value="&lt;b&gt;未知｜L 是否也防止文件內容被修改&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;要看其他程式怎麼用它。這決定待決 H（殘留的 L 有多嚴重）和待決 I（能不能先讀資料、後鎖定）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="982" width="860" height="66" /></mxCell><mxCell id="hcaapi-78" value="&lt;b&gt;工作清單&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;emr_general_sheet_worklist 的簽章狀態&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1062" width="300" height="86" /></mxCell><mxCell id="hcaapi-79" value="&lt;b&gt;未簽&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="1062" width="260" height="86" /></mxCell><mxCell id="hcaapi-80" value="&lt;b&gt;⑦ 工作清單已標為已簽&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="1062" width="260" height="86" /></mxCell><mxCell id="hcaapi-81" value="&lt;b&gt;已簽&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;文件此時即為已簽&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="955" y="1062" width="260" height="86" /></mxCell><mxCell id="hcaapi-82" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-78" target="hcaapi-79"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-79" target="hcaapi-80"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-80" target="hcaapi-81"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-85" value="&lt;b&gt;組合｜鎖定（L）＋未簽&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;正在簽，或 ⑦ 之前中途失敗。可整份重做&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1162" width="560" height="66" /></mxCell><mxCell id="hcaapi-86" value="&lt;b&gt;組合｜鎖定（L）＋已簽&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;既有缺口：⑦ 成功、⑨ 之前失敗。文件已簽，但登記停在 L&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="1162" width="560" height="66" /></mxCell><mxCell id="hcaapi-87" value="&lt;b&gt;組合｜完成（C）＋已簽&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;正常結束&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1162" width="560" height="66" /></mxCell><mxCell id="hcaapi-88" value="&lt;b&gt;簽章登記的開關關閉時〔W11〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;由代碼表控制；現場實際設定未知（待決 M）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1242" width="560" height="66" /></mxCell><mxCell id="hcaapi-89" value="&lt;b&gt;沒有 ① 和 ⑨，也沒有 L、C&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每份文件只剩工作清單一條線：未簽 → ⑦ → 已簽&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="1242" width="560" height="66" /></mxCell><mxCell id="hcaapi-90" value="&lt;b&gt;待決 H、I 與上面三種組合都不適用&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;鎖內只剩 ②③。驗收要兩種設定各測一次&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1242" width="560" height="66" /></mxCell><mxCell id="hcaapi-91" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-88" target="hcaapi-89"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-92" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-89" target="hcaapi-90"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-93" value="&lt;b&gt;這是病歷文件簽章的業務狀態，都寫入資料庫&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;狀態的種類、欄位與成功點（⑦）本設計不改&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1322" width="860" height="66" /></mxCell><mxCell id="hcaapi-94" value="&lt;b&gt;但兩階段化會改變它的時序&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;同一段內的文件會先全部進入鎖定（L），保存中止時多份停在這裡。這就是待決 H&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="1322" width="860" height="66" /></mxCell><mxCell id="hcaapi-95" value="&lt;b&gt;現況｜資料庫沒有交易&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;程式沒有關閉自動提交，推定逐句生效；結尾的 commit、rollback 不構成交易&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1412" width="560" height="86" /></mxCell><mxCell id="hcaapi-96" value="&lt;b&gt;現況｜⑦ 之前失敗的文件可以整份重做&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;簽章、時戳、上傳都可以重來；⑦ 之後不應重簽&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="1412" width="560" height="86" /></mxCell><mxCell id="hcaapi-97" value="&lt;b&gt;既有缺口｜⑦ 之後失敗會不一致&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;資料庫已指向新的 PDF 位置但檔案沒搬；或狀態停在 L。本次不修&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1412" width="560" height="86" /></mxCell><mxCell id="hcaapi-98" value="&lt;b&gt;初始化狀態不在〔v5〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;沒做過 initialize、已 closeModule，或先前被清除&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1522" width="400" height="66" /></mxCell><mxCell id="hcaapi-99" value="&lt;b&gt;未取鎖；未呼叫 DLL&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="1522" width="560" height="66" /></mxCell><mxCell id="hcaapi-100" value="&lt;b&gt;尚未初始化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;既有的回應；前端要重新 initialize&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1522" width="680" height="66" /></mxCell><mxCell id="hcaapi-101" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-98" target="hcaapi-99"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-102" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-99" target="hcaapi-100"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-103" value="&lt;b&gt;鎖內第 N 份的 ① 鎖定失敗〔W18〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;同一份文件已有另一筆登記是鎖定或完成&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1604" width="400" height="66" /></mxCell><mxCell id="hcaapi-104" value="&lt;b&gt;這一份沒有簽；Module 已關閉；鎖已釋放&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;① 在鎖內做，失敗後照樣清理。關 Module 失敗時依 02 頁處理&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="1604" width="560" height="66" /></mxCell><mxCell id="hcaapi-105" value="&lt;b&gt;前 N−1 份照常保存；第 N 份起回報失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;既有行為：自己那筆登記改為 Expired，整批在這一份停止。處理方式比照簽章失敗&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1604" width="680" height="66" /></mxCell><mxCell id="hcaapi-106" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-103" target="hcaapi-104"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-107" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-104" target="hcaapi-105"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-108" value="&lt;b&gt;鎖內第 N 份簽章失敗&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1686" width="400" height="66" /></mxCell><mxCell id="hcaapi-109" value="&lt;b&gt;操作失敗（錯誤碼）；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="1686" width="560" height="66" /></mxCell><mxCell id="hcaapi-110" value="&lt;b&gt;前 N−1 份照常保存；第 N 份起回報失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;與現在逐份處理的結果相同&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1686" width="680" height="66" /></mxCell><mxCell id="hcaapi-111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-108" target="hcaapi-109"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-112" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-109" target="hcaapi-110"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-113" value="&lt;b&gt;鎖外第 M 份保存失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;在 ⑦ 之前&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1768" width="400" height="66" /></mxCell><mxCell id="hcaapi-114" value="&lt;b&gt;不涉及卡片&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="1768" width="560" height="66" /></mxCell><mxCell id="hcaapi-115" value="&lt;b&gt;前 M−1 份已保存；第 M 份起回報失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;未保存的簽章直接丟棄，醫師重新簽章&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1768" width="680" height="66" /></mxCell><mxCell id="hcaapi-116" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-113" target="hcaapi-114"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-117" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="hcaapi-114" target="hcaapi-115"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="hcaapi-118" value="&lt;b&gt;待決 H｜殘留的鎖定（L）〔W18〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;保存中止時，同一段內未保存的文件都停在 L（現在最多一份），HCAAPI 沒有清除它的路徑&lt;br&gt;已確認：同一種簽章方式重試會沿用同一筆登記，可以再鎖定。但殘留的 L 會擋住其他簽章方式的登記&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1858" width="420" height="126" /></mxCell><mxCell id="hcaapi-119" value="&lt;b&gt;要改｜每份文件的資料要各自保留&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;文件、病歷號、PDF 暫存檔現在都是共用的 static 或固定檔名&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="485" y="1858" width="420" height="126" /></mxCell><mxCell id="hcaapi-120" value="&lt;b&gt;風險｜記憶體與持鎖時間&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;32 位元 JVM；批次十餘份以上可能超過對方的 15 秒&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="1858" width="420" height="126" /></mxCell><mxCell id="hcaapi-121" value="&lt;b&gt;每當簽完一段（K 份）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;→ 放鎖、保存這一段，再取鎖簽下一段。K 先量測再定（待決 B）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1395" y="1858" width="420" height="126" /></mxCell><mxCell id="hcaapi-122" value="&lt;b&gt;待決 I｜①② 要不要移到取鎖之前〔W8〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;只有 ③ 用卡。①② 移出去，持鎖時間變短，直接緩解「超過對方 15 秒」&lt;br&gt;代價：① 移出去後，等不到鎖時已有多份停在 L（待決 H 變大）；② 移到 ① 之前則變成「先讀資料、後登記」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="2002" width="860" height="86" /></mxCell><mxCell id="hcaapi-123" value="&lt;b&gt;建議（未定案）｜先量測；要縮短時優先考慮只移 ②〔W13〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;② 讀文件內容與 PDF 取檔，是鎖內最花時間的非用卡動作；① 是一次小的資料庫更新，留在鎖內不擴大待決 H&lt;br&gt;前提：L 不是用來防止內容被修改。若是，② 移到 ① 之前可能簽到舊內容，就不能移&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="2002" width="860" height="86" /></mxCell><mxCell id="hcaapi-124" value="&lt;b&gt;UC-H3｜其他指令&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="2132" width="1700" height="34" /></mxCell><mxCell id="hcaapi-125" value="&lt;b&gt;updateCardinfo、specialUpdateCardinfo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;用卡一次：開、核對身分、上傳憑證、關&lt;br&gt;待決 E：之後是否視為重新初始化&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="2172" width="420" height="86" /></mxCell><mxCell id="hcaapi-126" value="&lt;b&gt;checkHCAAPI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;用卡一次，但不登入：開 Module、讀卡片資料、關&lt;br&gt;待決 D：是否還要作廢初始化&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="485" y="2172" width="420" height="86" /></mxCell><mxCell id="hcaapi-127" value="&lt;b&gt;closeModule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不碰卡；清除初始化狀態&lt;br&gt;若資源異常則再試一次關閉&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="2172" width="420" height="86" /></mxCell><mxCell id="hcaapi-128" value="&lt;b&gt;驗章、驗時戳&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不碰卡、不取鎖&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1395" y="2172" width="420" height="86" /></mxCell></root></mxGraphModel></diagram><diagram id="decide" name="05｜決議、待決與驗收"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="decide-1" value="&lt;b&gt;決議、待決與驗收&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="decide-2" value="對應設計文件 docs/hca-card-mutex-design.md 第 6～10 節。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="decide-3" value="白板 V10｜2026-11-20" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="18" width="250" height="52" /></mxCell><mxCell id="decide-4" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="124" width="113" height="42" /></mxCell><mxCell id="decide-5" value="&lt;b&gt;命令&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="152" y="124" width="113" height="42" /></mxCell><mxCell id="decide-6" value="&lt;b&gt;流程步驟&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="274" y="124" width="113" height="42" /></mxCell><mxCell id="decide-7" value="&lt;b&gt;設備／外部&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="396" y="124" width="113" height="42" /></mxCell><mxCell id="decide-8" value="&lt;b&gt;業務事件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="518" y="124" width="113" height="42" /></mxCell><mxCell id="decide-9" value="&lt;b&gt;設備紀錄&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="124" width="113" height="42" /></mxCell><mxCell id="decide-10" value="&lt;b&gt;回應結果&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="762" y="124" width="113" height="42" /></mxCell><mxCell id="decide-11" value="&lt;b&gt;狀態&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="884" y="124" width="113" height="42" /></mxCell><mxCell id="decide-12" value="&lt;b&gt;不變量&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#c2aeea;" vertex="1" parent="1"><mxGeometry as="geometry" x="1006" y="124" width="113" height="42" /></mxCell><mxCell id="decide-13" value="&lt;b&gt;每當…就…&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1128" y="124" width="113" height="42" /></mxCell><mxCell id="decide-14" value="&lt;b&gt;已確認&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="124" width="113" height="42" /></mxCell><mxCell id="decide-15" value="&lt;b&gt;條件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1372" y="124" width="113" height="42" /></mxCell><mxCell id="decide-16" value="&lt;b&gt;驗收&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="1494" y="124" width="113" height="42" /></mxCell><mxCell id="decide-17" value="&lt;b&gt;待釐清&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1616" y="124" width="113" height="42" /></mxCell><mxCell id="decide-18" value="&lt;b&gt;已決議（2026-11-19 review）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="190" width="1700" height="34" /></mxCell><mxCell id="decide-19" value="&lt;b&gt;修改 HCAAPI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每個用卡指令自開自關並加鎖；不再握著 Session&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="230" width="410" height="66" /></mxCell><mxCell id="decide-20" value="&lt;b&gt;不另做共享的「暫停狀態」&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Module 沒確認關閉就不放鎖，鎖本身就是訊號&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="230" width="410" height="66" /></mxCell><mxCell id="decide-21" value="&lt;b&gt;HCAAPI 的 callAPI 整體序列化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;第一版前提。鎖的順序：callAPI 鎖 → 卡片鎖&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="230" width="410" height="66" /></mxCell><mxCell id="decide-22" value="&lt;b&gt;批次簽章：鎖內簽完，鎖外保存&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="230" width="410" height="66" /></mxCell><mxCell id="decide-23" value="&lt;b&gt;鎖檔失敗就拒絕用卡&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不繞過&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="320" width="410" height="86" /></mxCell><mxCell id="decide-24" value="&lt;b&gt;等不到鎖就回報使用者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;沒有排程，程式不自動重試&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="320" width="410" height="86" /></mxCell><mxCell id="decide-25" value="&lt;b&gt;混版不保證互斥，也不保證行為沒有退化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;原決議「iccard 先上、HCAAPI 後上」改列待決 K 重新確認&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="320" width="410" height="86" /></mxCell><mxCell id="decide-26" value="&lt;b&gt;不改變病歷文件簽章狀態的種類與成功點&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;時序的改變見待決 H&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="320" width="410" height="86" /></mxCell><mxCell id="decide-27" value="&lt;b&gt;F｜iccard 的卡號比對納入（11-20）〔W16〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;驗卡時加記卡號，簽章前比對。讀卡號不需要 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="430" width="410" height="106" /></mxCell><mxCell id="decide-28" value="&lt;b&gt;J｜iccard 遇到 9039 就停（11-20）〔W16〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;以卡號比對為條件，所以 F 和 J 一起上版&lt;br&gt;每當已驗證過的 PIN、在卡號相符的卡上回 9039 → 撤銷簽章情境、不再自動送 PIN，要醫師重新驗卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="430" width="410" height="106" /></mxCell><mxCell id="decide-29" value="&lt;b&gt;元件不自動重試任何 DLL 錯誤碼〔早期 1〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;唯一的重試是關 Module。要不要再試由使用者決定&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="430" width="410" height="106" /></mxCell><mxCell id="decide-30" value="&lt;b&gt;9043 單獨處理〔W22〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;回「卡片已鎖」，不和其他 PIN 類錯誤共用訊息；清除記住的 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="430" width="410" height="106" /></mxCell><mxCell id="decide-31" value="&lt;b&gt;用卡流程做成共用元件（11-20）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;iccard 開發並產出 jar，HCAAPI 引用；不各寫一份&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="560" width="410" height="66" /></mxCell><mxCell id="decide-32" value="&lt;b&gt;共用元件只管「怎麼安全用卡」&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;簽什麼、怎麼保存留在各自程式，以回呼接上&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="560" width="410" height="66" /></mxCell><mxCell id="decide-33" value="&lt;b&gt;HCAAPI 先改為 Gradle 建置（11-20）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;原始碼與相依不動；作為引用共用元件的前置步驟&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="560" width="410" height="66" /></mxCell><mxCell id="decide-34" value="&lt;b&gt;HCAAPI 升級 Spring Boot 2 另案&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不是互斥的前提；排在互斥之後&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="560" width="410" height="66" /></mxCell><mxCell id="decide-35" value="&lt;b&gt;待決&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="670" width="1700" height="34" /></mxCell><mxCell id="decide-36" value="&lt;b&gt;A｜等待上限〔D4〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議兩邊不同：iccard 等 15 秒；HCAAPI 只需等 iccard 的一次用卡（約 3 秒），設 6 秒左右。量測後調整&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="710" width="410" height="86" /></mxCell><mxCell id="decide-37" value="&lt;b&gt;B｜批次分段大小 K&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議第一版整批，依量測決定是否設上限&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="710" width="410" height="86" /></mxCell><mxCell id="decide-38" value="&lt;b&gt;C｜鎖檔路徑&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議 C:\opdsysora\newHis\hca-card.lock&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="710" width="410" height="86" /></mxCell><mxCell id="decide-39" value="&lt;b&gt;D｜checkHCAAPI 要不要作廢初始化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;現在會；建議不作廢，需前端確認&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="710" width="410" height="86" /></mxCell><mxCell id="decide-40" value="&lt;b&gt;E｜updateCardinfo 之後能否直接簽章&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;現在可以，但用的是舊的金鑰 handle；建議視為重新初始化&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="820" width="410" height="130" /></mxCell><mxCell id="decide-41" value="&lt;b&gt;N｜結束電子病歷簽章時，UI 會不會呼叫 closeModule〔W19〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;舊版 HCAAPI 只有 closeModule 才放掉卡。不會的話，驗卡（UC-I1）和開處方（UC-I2）兩處 9039 的提示都要改成「關閉電子病歷簽章程式」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="820" width="410" height="130" /></mxCell><mxCell id="decide-42" value="&lt;b&gt;G｜要不要做行程中止實驗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議做一次：握住 Session 後強制結束，另一方登入一次&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="820" width="410" height="130" /></mxCell><mxCell id="decide-43" value="&lt;b&gt;H｜殘留的鎖定（L）狀態怎麼處理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;同一種簽章方式重試沿用同一筆登記（已確認），但會擋住其他簽章方式。要先了解 L 在其他程式的用途&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="820" width="410" height="130" /></mxCell><mxCell id="decide-44" value="&lt;b&gt;I｜批次的 ①② 要不要移到取鎖之前&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;先量測；要等弄清 L 的用途才能定。見 04 頁&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="974" width="410" height="150" /></mxCell><mxCell id="decide-45" value="&lt;b&gt;M｜簽章登記的開關，現場是開還是關&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;關閉時沒有 L、C，待決 H、I 不適用&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="974" width="410" height="150" /></mxCell><mxCell id="decide-46" value="&lt;b&gt;備案（未定案）｜連續開處方讓 HCAAPI 等太久時〔D13〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;先量測（T6）。不夠再加「放鎖後短暫讓出」；還不夠才加排隊鎖&lt;br&gt;排隊鎖：兩邊都先取排隊鎖、再取卡片鎖、拿到後放掉排隊鎖。用作業系統的檔案鎖，不寫登記紀錄，當掉不會殘留&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="974" width="410" height="150" /></mxCell><mxCell id="decide-47" value="&lt;b&gt;O｜前端 socket 呼叫的逾時多長〔D4〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;callAPI 序列化後，等卡片鎖的期間其他指令（含不碰卡的驗章）都排在後面。逾時若短於等待上限，前端會先放棄&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="974" width="410" height="150" /></mxCell><mxCell id="decide-48" value="&lt;b&gt;混版期間的鎖卡風險（目前唯一可能鎖卡的風險）〔W6〕&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1168" width="1700" height="34" /></mxCell><mxCell id="decide-49" value="&lt;b&gt;風險｜舊版 HCAAPI 握著 Session 時，iccard 每開一張處方就一次 9039&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;今天就存在。iccard 先上版不會消除它：舊版 HCAAPI 不取鎖，iccard 一定拿得到鎖，卡號也相符，於是送出 PIN&lt;br&gt;9039 若會扣次數，醫師連開三張就鎖卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1208" width="560" height="130" /></mxCell><mxCell id="decide-50" value="&lt;b&gt;已確認｜危險來自舊版 HCAAPI，和 iccard 是新是舊無關&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;現行 iccard 每次都重新開 Module 並登入（讀程式所得），不會停在 9046。新版不會比現在多送 PIN，也不會少送&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="1208" width="560" height="130" /></mxCell><mxCell id="decide-51" value="&lt;b&gt;已確認｜廠商元件沒有「查詢 PIN 剩餘次數」的方法&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;兩個版本的公開方法都查過。要查只能靠廠商、正式環境紀錄，或繞過廠商元件&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1208" width="560" height="130" /></mxCell><mxCell id="decide-52" value="&lt;b&gt;J 擋不住的部分〔W15〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;J 把「每張處方送一次 PIN」降為「每次重新驗卡送一次」，是降低，不是消除&lt;br&gt;驗卡（UC-I1）當下的 9039 分不出是打錯還是被佔用，只能靠提示文字勸醫師不要重打&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1362" width="560" height="146" /></mxCell><mxCell id="decide-53" value="&lt;b&gt;K｜上版順序與 F＋J 的時機〔W17、D9〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;決定一：F＋J 要不要先於互斥單獨上版。建議要：風險今天就在正式環境，而 F＋J 只改 iccard&lt;br&gt;決定二：互斥的上版順序。iccard 先上、兩支一起上，或 HCAAPI 先上&lt;br&gt;HCAAPI 先上時它不再握著 Session，佔卡窗口縮小；但批次在鎖內仍會佔十幾秒，舊版 iccard 不取鎖照樣登入。要用 T6 量測，和待決 B 一起評估&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="1362" width="560" height="146" /></mxCell><mxCell id="decide-54" value="&lt;b&gt;L｜查清 9039 會不會扣 PIN 次數〔提醒〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;問廠商；查正式環境有沒有 9039 與鎖卡紀錄；有測試卡就實驗&lt;br&gt;可評估用標準 PKCS#11 工具讀 PIN 計數旗標，只需觸發一次 9039。卡片的中介軟體會不會回報要實測；實驗一律用測試卡，不用正式卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1362" width="560" height="146" /></mxCell><mxCell id="decide-55" value="&lt;b&gt;驗收&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1552" width="1700" height="34" /></mxCell><mxCell id="decide-56" value="&lt;b&gt;T1｜兩個 JVM 搶鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A 在鎖內時 B 等待且沒有碰 DLL；A 放鎖後 B 取得。交換角色&lt;br&gt;同一個 JVM 重複取鎖不會出錯；資源異常時鎖確實還在〔D3〕&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1592" width="410" height="126" /></mxCell><mxCell id="decide-57" value="&lt;b&gt;T2｜清理與結果分開（假 DLL）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;關 Session 失敗仍會關 Module&lt;br&gt;先回簽章再讓關 Module 失敗：只簽一次、簽章有回傳、鎖沒放&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="1592" width="410" height="126" /></mxCell><mxCell id="decide-58" value="&lt;b&gt;T3｜不送 PIN 的情況&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;卡號不符、等不到鎖、鎖檔失敗：都沒有呼叫 InitSession&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="1592" width="410" height="126" /></mxCell><mxCell id="decide-59" value="&lt;b&gt;T4｜POC 加鎖後重跑 E1～E3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;預期不再出現 9039、9062、9016，簽章全部驗章通過&lt;br&gt;另測：不關 Session、只關 Module 之後，對方能正常登入〔D5〕&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="1592" width="410" height="126" /></mxCell><mxCell id="decide-60" value="&lt;b&gt;T5｜正式程式實機&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;已初始化時開處方；批次的鎖內與保存階段各開一次處方；換卡後簽章；批次中途拔卡。簽章登記開關開、關各測一次&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1742" width="410" height="106" /></mxCell><mxCell id="decide-61" value="&lt;b&gt;T6｜量測&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;批次每份在鎖內的耗時、整批記憶體用量；醫師連續開幾張處方時 HCAAPI 等多久〔D13〕&lt;br&gt;用來決定 A 與 B&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="1742" width="410" height="106" /></mxCell><mxCell id="decide-62" value="&lt;b&gt;上線條件&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;兩邊同一個鎖檔與規則；所有會開 Module 的入口都走共用流程；兩個執行帳號都能寫鎖檔&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="1742" width="410" height="106" /></mxCell><mxCell id="decide-63" value="&lt;b&gt;HCAAPI 修改風險&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;HCAUtils 約三千行、全 static、沒有測試；批次兩階段化風險最高&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="1742" width="410" height="106" /></mxCell><mxCell id="decide-64" value="&lt;b&gt;T7｜共用元件跨版本&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;只用兩版廠商 jar 共有的方法；同一個 jar 掛上 HCAAPI 的舊版廠商 jar 實機跑過&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1872" width="410" height="106" /></mxCell><mxCell id="decide-65" value="&lt;b&gt;T8｜HCAAPI 換建置後回歸&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;引用共用元件之前，先以現行功能回歸一次，含 NHI 模式&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="1872" width="410" height="106" /></mxCell><mxCell id="decide-66" value="&lt;b&gt;T9｜混版情境〔W6〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;舊版 HCAAPI 已初始化時，新版 iccard 開處方：只送一次 PIN，之後停止並提示。驗卡遇到 9039 時提示可能被佔用&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="1872" width="410" height="106" /></mxCell><mxCell id="decide-67" value="&lt;b&gt;開發順序&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;① iccard 做共用元件 ② HCAAPI 改 Gradle ③ HCAAPI 引用元件。上版順序見待決 K&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="1872" width="410" height="106" /></mxCell></root></mxGraphModel></diagram><diagram id="review" name="06｜審閱意見對照"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="review-1" value="&lt;b&gt;審閱意見對照&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="review-2" value="W、P 開頭的編號是專家審閱意見的問題編號。這一頁列出每一項在白板與設計文件的位置；相關便利貼的標題後面也加了〔編號〕。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="review-3" value="白板 V10｜2026-11-20" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="18" width="250" height="52" /></mxCell><mxCell id="review-4" value="&lt;b&gt;編號&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="130" width="150" height="46" /></mxCell><mxCell id="review-5" value="&lt;b&gt;審閱時的問題&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="194" y="130" width="560" height="46" /></mxCell><mxCell id="review-6" value="&lt;b&gt;狀態&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="768" y="130" width="150" height="46" /></mxCell><mxCell id="review-7" value="&lt;b&gt;白板位置&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="932" y="130" width="480" height="46" /></mxCell><mxCell id="review-8" value="&lt;b&gt;設計文件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1426" y="130" width="300" height="46" /></mxCell><mxCell id="review-9" value="&lt;b&gt;（v2）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="186" width="150" height="46" /></mxCell><mxCell id="review-10" value="&lt;b&gt;橘色便利貼不是業務事件，混入「某件事沒發生」&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="194" y="186" width="560" height="46" /></mxCell><mxCell id="review-11" value="&lt;b&gt;已處理&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="768" y="186" width="150" height="46" /></mxCell><mxCell id="review-12" value="&lt;b&gt;全白板：業務事件、設備紀錄、回應結果三種顏色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="932" y="186" width="480" height="46" /></mxCell><mxCell id="review-13" value="&lt;b&gt;—&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1426" y="186" width="300" height="46" /></mxCell><mxCell id="review-14" value="&lt;b&gt;W1–W3&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="242" width="150" height="46" /></mxCell><mxCell id="review-15" value="&lt;b&gt;顏色用錯：命令、規則、已確認用在不對的東西上&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="194" y="242" width="560" height="46" /></mxCell><mxCell id="review-16" value="&lt;b&gt;已處理&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="768" y="242" width="150" height="46" /></mxCell><mxCell id="review-17" value="&lt;b&gt;全白板：新增流程步驟、狀態、驗收三種顏色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="932" y="242" width="480" height="46" /></mxCell><mxCell id="review-18" value="&lt;b&gt;—&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1426" y="242" width="300" height="46" /></mxCell><mxCell id="review-19" value="&lt;b&gt;W4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="298" width="150" height="46" /></mxCell><mxCell id="review-20" value="&lt;b&gt;⑦ 寫成動作，不是過去式&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="194" y="298" width="560" height="46" /></mxCell><mxCell id="review-21" value="&lt;b&gt;已處理&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="768" y="298" width="150" height="46" /></mxCell><mxCell id="review-22" value="&lt;b&gt;04 頁 ⑦ 工作清單已標為已簽&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="932" y="298" width="480" height="46" /></mxCell><mxCell id="review-23" value="&lt;b&gt;§6.6 步驟表&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1426" y="298" width="300" height="46" /></mxCell><mxCell id="review-24" value="&lt;b&gt;W5&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="354" width="150" height="46" /></mxCell><mxCell id="review-25" value="&lt;b&gt;「處方已簽章」在範圍內沒有人記住&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="194" y="354" width="560" height="46" /></mxCell><mxCell id="review-26" value="&lt;b&gt;已處理&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="768" y="354" width="150" height="46" /></mxCell><mxCell id="review-27" value="&lt;b&gt;03 頁「iccard 這一段沒有業務事件」&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="932" y="354" width="480" height="46" /></mxCell><mxCell id="review-28" value="&lt;b&gt;§8 對業務狀態的影響&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1426" y="354" width="300" height="46" /></mxCell><mxCell id="review-29" value="&lt;b&gt;W6&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="410" width="150" height="70" /></mxCell><mxCell id="review-30" value="&lt;b&gt;混版期間可能鎖卡&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9