<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net" compressed="false" pages="6"><diagram id="current" name="01｜現況與實驗事實"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="current-1" value="&lt;b&gt;同機共用醫事人員卡｜現況與實驗事實&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="current-2" value="範圍：一般讀卡機 PC/SC。不含 HCAAPI 的 NHI 模式、iccard 的 HCA_CLI 模式。兩支程式都由這台電腦的使用者本人操作觸發，沒有排程。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="current-3" value="白板 V10｜2026-11-20" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="18" width="250" height="52" /></mxCell><mxCell id="current-4" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="124" width="113" height="42" /></mxCell><mxCell id="current-5" value="&lt;b&gt;命令&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="152" y="124" width="113" height="42" /></mxCell><mxCell id="current-6" value="&lt;b&gt;流程步驟&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="274" y="124" width="113" height="42" /></mxCell><mxCell id="current-7" value="&lt;b&gt;設備／外部&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="396" y="124" width="113" height="42" /></mxCell><mxCell id="current-8" value="&lt;b&gt;業務事件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="518" y="124" width="113" height="42" /></mxCell><mxCell id="current-9" value="&lt;b&gt;設備紀錄&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="124" width="113" height="42" /></mxCell><mxCell id="current-10" value="&lt;b&gt;回應結果&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="762" y="124" width="113" height="42" /></mxCell><mxCell id="current-11" value="&lt;b&gt;狀態&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="884" y="124" width="113" height="42" /></mxCell><mxCell id="current-12" value="&lt;b&gt;不變量&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#c2aeea;" vertex="1" parent="1"><mxGeometry as="geometry" x="1006" y="124" width="113" height="42" /></mxCell><mxCell id="current-13" value="&lt;b&gt;每當…就…&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1128" y="124" width="113" height="42" /></mxCell><mxCell id="current-14" value="&lt;b&gt;已確認&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="124" width="113" height="42" /></mxCell><mxCell id="current-15" value="&lt;b&gt;條件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1372" y="124" width="113" height="42" /></mxCell><mxCell id="current-16" value="&lt;b&gt;驗收&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="1494" y="124" width="113" height="42" /></mxCell><mxCell id="current-17" value="&lt;b&gt;待釐清&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1616" y="124" width="113" height="42" /></mxCell><mxCell id="current-18" value="&lt;b&gt;iccard localserver｜電子處方箋&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="190" width="1700" height="34" /></mxCell><mxCell id="current-19" value="&lt;b&gt;醫師&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;開立電子處方&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="230" width="260" height="86" /></mxCell><mxCell id="current-20" value="&lt;b&gt;簽一張處方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;驗卡時另有取憑證序號、取卡片資料&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="325" y="230" width="300" height="86" /></mxCell><mxCell id="current-21" value="&lt;b&gt;HCA DLL／讀卡機／卡片&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每次操作自開自關，約 2.7 秒&lt;br&gt;jar 版本 1,0,12,410&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="230" width="380" height="86" /></mxCell><mxCell id="current-22" value="&lt;b&gt;QR Code 已產生並回傳&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;iccard 自己用簽章值產生；或：某一步失敗，直接拋錯&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1075" y="230" width="330" height="86" /></mxCell><mxCell id="current-23" value="&lt;b&gt;失敗時沒有關 Session 與 Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;回傳碼沒檢查；清理拋例外時會丟掉已取得的簽章&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440" y="230" width="330" height="86" /></mxCell><mxCell id="current-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-19" target="current-20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-20" target="current-21"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-21" target="current-22"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-22" target="current-23"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-28" value="&lt;b&gt;HCAAPI localserver｜電子病歷&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="350" width="1700" height="34" /></mxCell><mxCell id="current-29" value="&lt;b&gt;醫師&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;在 UI 按「開始簽章」，UI 之後定期呼叫&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="390" width="260" height="86" /></mxCell><mxCell id="current-30" value="&lt;b&gt;initialize → makeSignature&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;分開的指令；指令不帶 handle&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="325" y="390" width="300" height="86" /></mxCell><mxCell id="current-31" value="&lt;b&gt;HCA DLL／讀卡機／卡片&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Session 從 initialize 握到 closeModule&lt;br&gt;jar 版本 1,0,10,1208&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="390" width="380" height="86" /></mxCell><mxCell id="current-32" value="&lt;b&gt;工作清單逐份標為已簽&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每份：雜湊、簽章、時戳、上傳、回寫資料庫&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="1075" y="390" width="330" height="86" /></mxCell><mxCell id="current-33" value="&lt;b&gt;狀態全在 static 欄位，沒有同步&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;關閉回錯誤時 handle 不清零，之後初始化持續失敗&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440" y="390" width="330" height="86" /></mxCell><mxCell id="current-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-29" target="current-30"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-30" target="current-31"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-31" target="current-32"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-32" target="current-33"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-38" value="&lt;b&gt;已解決，與本題分開&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="520" width="1700" height="34" /></mxCell><mxCell id="current-39" value="&lt;b&gt;DLL 檔案衝突已排除&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;iccard 把原生檔解到自己的目錄；實機確認兩支程式可以任意順序啟動&lt;br&gt;已提交，待上版。這只解決檔案衝突，不解決卡片互斥&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="560" width="820" height="86" /></mxCell><mxCell id="current-40" value="&lt;b&gt;實驗觀察（一台電腦、一台讀卡機、一張卡，三輪）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="690" width="1700" height="34" /></mxCell><mxCell id="current-41" value="&lt;b&gt;兩個行程可以同時開 Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;三輪都成功&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="730" width="320" height="106" /></mxCell><mxCell id="current-42" value="&lt;b&gt;一方登入中，另一方登入失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;HCAAPI 去試：9062（一次）&lt;br&gt;iccard 去試：9039 PIN 錯誤（兩次，PIN 無誤）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="385" y="730" width="320" height="106" /></mxCell><mxCell id="current-43" value="&lt;b&gt;登入失敗後，對方仍能簽章&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;一次&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="740" y="730" width="320" height="106" /></mxCell><mxCell id="current-44" value="&lt;b&gt;一方關 Module 後，另一方下次簽章失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;9016（拆開步驟的只有一次）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1095" y="730" width="320" height="106" /></mxCell><mxCell id="current-45" value="&lt;b&gt;登入失敗後，同一個 Module 要重開&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;之後一律 9046&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1450" y="730" width="320" height="106" /></mxCell><mxCell id="current-46" value="&lt;b&gt;未知｜9039 會不會扣 PIN 次數&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;驗證要連錯三次，有鎖卡風險，沒有做&lt;br&gt;設計上一律當成會扣&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="866" width="400" height="86" /></mxCell><mxCell id="current-47" value="&lt;b&gt;未知｜行程當掉後卡片的狀態&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;下一個行程能否正常登入，沒有測過&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="866" width="400" height="86" /></mxCell><mxCell id="current-48" value="&lt;b&gt;未知｜關 Module 為何影響對方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;耗時是平常的五倍，原因沒有證據&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="866" width="400" height="86" /></mxCell><mxCell id="current-49" value="&lt;b&gt;未測｜iccard 簽章中遇到 checkHCAAPI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;它不登入但會開關 Module，依上面的觀察推論會出事&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1335" y="866" width="400" height="86" /></mxCell></root></mxGraphModel></diagram><diagram id="shared" name="02｜共用規則與卡片資源"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="shared-1" value="&lt;b&gt;共用｜規則、卡片資源狀態與復原（提案，尚未實作）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="shared-2" value="所有 use case 共用。業務事件、設備操作紀錄、回給呼叫端的結果分開命名。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="shared-3" value="白板 V10｜2026-11-20" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="18" width="250" height="52" /></mxCell><mxCell id="shared-4" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="124" width="113" height="42" /></mxCell><mxCell id="shared-5" value="&lt;b&gt;命令&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="152" y="124" width="113" height="42" /></mxCell><mxCell id="shared-6" value="&lt;b&gt;流程步驟&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="274" y="124" width="113" height="42" /></mxCell><mxCell id="shared-7" value="&lt;b&gt;設備／外部&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="396" y="124" width="113" height="42" /></mxCell><mxCell id="shared-8" value="&lt;b&gt;業務事件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="518" y="124" width="113" height="42" /></mxCell><mxCell id="shared-9" value="&lt;b&gt;設備紀錄&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="124" width="113" height="42" /></mxCell><mxCell id="shared-10" value="&lt;b&gt;回應結果&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="762" y="124" width="113" height="42" /></mxCell><mxCell id="shared-11" value="&lt;b&gt;狀態&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="884" y="124" width="113" height="42" /></mxCell><mxCell id="shared-12" value="&lt;b&gt;不變量&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#c2aeea;" vertex="1" parent="1"><mxGeometry as="geometry" x="1006" y="124" width="113" height="42" /></mxCell><mxCell id="shared-13" value="&lt;b&gt;每當…就…&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1128" y="124" width="113" height="42" /></mxCell><mxCell id="shared-14" value="&lt;b&gt;已確認&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="124" width="113" height="42" /></mxCell><mxCell id="shared-15" value="&lt;b&gt;條件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1372" y="124" width="113" height="42" /></mxCell><mxCell id="shared-16" value="&lt;b&gt;驗收&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="1494" y="124" width="113" height="42" /></mxCell><mxCell id="shared-17" value="&lt;b&gt;待釐清&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1616" y="124" width="113" height="42" /></mxCell><mxCell id="shared-18" value="&lt;b&gt;不變量 1｜先取得鎖，才能開 Module〔W10〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;鎖從 InitModule 之前護到 CloseModule 之後&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#c2aeea;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="190" width="560" height="66" /></mxCell><mxCell id="shared-19" value="&lt;b&gt;不變量 2｜Module 確認關閉，才能放鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;持鎖的意思是「我可能還有 Module 開著」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#c2aeea;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="190" width="560" height="66" /></mxCell><mxCell id="shared-20" value="&lt;b&gt;不變量 3｜對方可能持卡時，不送 PIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;取鎖後先讀卡號比對，不符也不送 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#c2aeea;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="190" width="560" height="66" /></mxCell><mxCell id="shared-21" value="&lt;b&gt;範圍｜這是兩支程式共用一個設備的協調，不是領域模型&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不改變病歷文件簽章狀態的種類、欄位與成功點。例外：批次兩階段化會改變停在鎖定（L）的份數與時間（待決 H）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="280" width="860" height="66" /></mxCell><mxCell id="shared-22" value="&lt;b&gt;新增的狀態只有兩個，都在行程內、不持久化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;卡片資源狀態（下方）；HCAAPI 的初始化狀態（見 HCAAPI 頁）。鎖不是 Aggregate，也不是 use case&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="280" width="860" height="66" /></mxCell><mxCell id="shared-23" value="&lt;b&gt;用卡一次（各 use case 引用這一段，不重畫）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="386" width="1700" height="34" /></mxCell><mxCell id="shared-24" value="&lt;b&gt;取鎖〔W25〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;等待上限：iccard 15 秒、HCAAPI 約 6 秒（待決 A）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="426" width="220" height="86" /></mxCell><mxCell id="shared-25" value="&lt;b&gt;開 Module&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="285" y="426" width="240" height="86" /></mxCell><mxCell id="shared-26" value="&lt;b&gt;讀卡號並比對&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不需要 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="426" width="260" height="86" /></mxCell><mxCell id="shared-27" value="&lt;b&gt;登入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;送 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="855" y="426" width="240" height="86" /></mxCell><mxCell id="shared-28" value="&lt;b&gt;該 use case 的操作&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;讀憑證、取金鑰、雜湊、簽章&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="426" width="260" height="86" /></mxCell><mxCell id="shared-29" value="&lt;b&gt;關 Session → 關 Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;兩個都做，都檢查回傳碼&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1425" y="426" width="260" height="86" /></mxCell><mxCell id="shared-30" value="&lt;b&gt;放鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;只有關 Module 成功時&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1720" y="426" width="220" height="86" /></mxCell><mxCell id="shared-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-24" target="shared-25"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-25" target="shared-26"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-26" target="shared-27"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-27" target="shared-28"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-28" target="shared-29"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-29" target="shared-30"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-37" value="&lt;b&gt;條件　→　設備操作紀錄　→　回給呼叫端的結果&lt;/b&gt;（業務事件由各 use case 自己定義；只有「完成」會產生業務事件）" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="546" width="1700" height="30" /></mxCell><mxCell id="shared-38" value="&lt;b&gt;一切正常&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="584" width="400" height="66" /></mxCell><mxCell id="shared-39" value="&lt;b&gt;鎖已取得；Module 已開啟並已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="584" width="560" height="66" /></mxCell><mxCell id="shared-40" value="&lt;b&gt;完成&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;附上該 use case 的資料&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="584" width="680" height="66" /></mxCell><mxCell id="shared-41" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-38" target="shared-39"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-39" target="shared-40"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-43" value="&lt;b&gt;等待上限內等不到鎖&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="666" width="400" height="66" /></mxCell><mxCell id="shared-44" value="&lt;b&gt;未呼叫 DLL；未送出 PIN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="666" width="560" height="66" /></mxCell><mxCell id="shared-45" value="&lt;b&gt;卡片使用中&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;附佔用者；由使用者重試，程式不自動重試&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="666" width="680" height="66" /></mxCell><mxCell id="shared-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-43" target="shared-44"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-44" target="shared-45"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-48" value="&lt;b&gt;鎖檔無法建立或開啟&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="748" width="400" height="66" /></mxCell><mxCell id="shared-49" value="&lt;b&gt;未呼叫 DLL；未送出 PIN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="748" width="560" height="66" /></mxCell><mxCell id="shared-50" value="&lt;b&gt;無法協調，拒絕用卡&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不繞過；提示聯絡資訊室&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="748" width="680" height="66" /></mxCell><mxCell id="shared-51" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-48" target="shared-49"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-52" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-49" target="shared-50"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-53" value="&lt;b&gt;卡號與預期不符&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="830" width="400" height="66" /></mxCell><mxCell id="shared-54" value="&lt;b&gt;未送出 PIN；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="830" width="560" height="66" /></mxCell><mxCell id="shared-55" value="&lt;b&gt;卡片不符&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;需重新驗卡或重新初始化&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="830" width="680" height="66" /></mxCell><mxCell id="shared-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-53" target="shared-54"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-54" target="shared-55"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-58" value="&lt;b&gt;DLL 回錯誤碼〔早期 1〕&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="912" width="400" height="66" /></mxCell><mxCell id="shared-59" value="&lt;b&gt;操作失敗（錯誤碼）；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="912" width="560" height="66" /></mxCell><mxCell id="shared-60" value="&lt;b&gt;用卡失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;附錯誤碼。任何錯誤碼元件都不自動重試，要不要再試由使用者決定&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="912" width="680" height="66" /></mxCell><mxCell id="shared-61" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-58" target="shared-59"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-59" target="shared-60"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-63" value="&lt;b&gt;登入回 9043〔W22、W24、W26〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;卡片已鎖；任何 use case 都一樣&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="994" width="400" height="86" /></mxCell><mxCell id="shared-64" value="&lt;b&gt;登入失敗（9043）；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="994" width="560" height="86" /></mxCell><mxCell id="shared-65" value="&lt;b&gt;卡片已鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;明確告知不要再試，依院內流程解鎖（HCAAPI 現有訊息是請醫師把卡送人事行政課）&lt;br&gt;清除記住的 PIN：iccard 撤銷或不建立簽章情境，HCAAPI 清除初始化狀態&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="994" width="680" height="86" /></mxCell><mxCell id="shared-66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-63" target="shared-64"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-64" target="shared-65"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-68" value="&lt;b&gt;關 Session 失敗，關 Module 成功〔早期 2〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不論前面是哪一種結果&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1096" width="400" height="90" /></mxCell><mxCell id="shared-69" value="&lt;b&gt;Session 關閉失敗（錯誤碼）；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="1096" width="560" height="90" /></mxCell><mxCell id="shared-70" value="&lt;b&gt;和前面的結果相同&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;只記錄錯誤碼，不改變回給呼叫端的結果&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1096" width="680" height="90" /></mxCell><mxCell id="shared-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-68" target="shared-69"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-69" target="shared-70"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-73" value="&lt;b&gt;關 Module 失敗〔早期 3〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;重試三次仍失敗；不論前面是完成、卡片不符還是用卡失敗&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1202" width="400" height="86" /></mxCell><mxCell id="shared-74" value="&lt;b&gt;Module 未確認關閉；鎖未釋放&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;卡片資源進入「異常」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="1202" width="560" height="86" /></mxCell><mxCell id="shared-75" value="&lt;b&gt;和前面的結果相同（完成的照常回傳，不重做）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;之後的用卡回「卡片資源異常，請重新啟動程式」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1202" width="680" height="86" /></mxCell><mxCell id="shared-76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-73" target="shared-74"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-74" target="shared-75"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-78" value="&lt;b&gt;卡片資源狀態（每個行程各自記錄；對方只看得到「鎖拿不拿得到」）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1332" width="1700" height="34" /></mxCell><mxCell id="shared-79" value="&lt;b&gt;空閒&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;沒有持鎖，沒有 Module&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1372" width="300" height="66" /></mxCell><mxCell id="shared-80" value="&lt;b&gt;鎖已取得&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="1372" width="240" height="66" /></mxCell><mxCell id="shared-81" value="&lt;b&gt;使用中&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;持鎖，Module 可能開著&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="1372" width="300" height="66" /></mxCell><mxCell id="shared-82" value="&lt;b&gt;Module 已關閉&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="1372" width="240" height="66" /></mxCell><mxCell id="shared-83" value="&lt;b&gt;空閒&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="1372" width="300" height="66" /></mxCell><mxCell id="shared-84" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-79" target="shared-80"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-85" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-80" target="shared-81"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-86" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-81" target="shared-82"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-87" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-82" target="shared-83"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-88" value="&lt;b&gt;使用中&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1456" width="300" height="66" /></mxCell><mxCell id="shared-89" value="&lt;b&gt;Module 未能關閉&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;已重試三次&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="365" y="1456" width="240" height="66" /></mxCell><mxCell id="shared-90" value="&lt;b&gt;異常&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;持鎖不放；Module 可能還開著&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="1456" width="300" height="66" /></mxCell><mxCell id="shared-91" value="&lt;b&gt;下次用卡前再試關閉&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;成功 → 空閒&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="975" y="1456" width="240" height="66" /></mxCell><mxCell id="shared-92" value="&lt;b&gt;或：使用者重新啟動該程式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Module 與鎖隨行程消失&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="1456" width="300" height="66" /></mxCell><mxCell id="shared-93" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-88" target="shared-89"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-89" target="shared-90"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-95" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-90" target="shared-91"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-96" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="shared-91" target="shared-92"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="shared-97" value="&lt;b&gt;復原&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1556" width="1700" height="34" /></mxCell><mxCell id="shared-98" value="&lt;b&gt;每當 Module 未能關閉&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;→ 不放鎖，自己也拒絕用卡（隔離）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1596" width="410" height="86" /></mxCell><mxCell id="shared-99" value="&lt;b&gt;每當取鎖逾時&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;→ 回「卡片使用中」並顯示佔用者。.owner 檔只供顯示，不作為放行依據&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="1596" width="410" height="86" /></mxCell><mxCell id="shared-100" value="&lt;b&gt;每當處於異常時又要用卡&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;→ 先再試關閉；仍失敗就提示重新啟動該程式。不需要管理者改任何共享狀態&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="1596" width="410" height="86" /></mxCell><mxCell id="shared-101" value="&lt;b&gt;每當取得鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;→ 先讀卡號比對（不需 PIN），相符才登入。行程崩潰後由作業系統放鎖，下一位照這條走&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="1596" width="410" height="86" /></mxCell><mxCell id="shared-102" value="&lt;b&gt;未知｜行程崩潰或重啟後，卡片停在什麼狀態&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;鎖無法表達這件事。要靠一次實驗確認（待決 G）；若卡片會留在不可用狀態，復原步驟要再加（例如提示重新插卡）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1700" width="860" height="66" /></mxCell><mxCell id="shared-103" value="&lt;b&gt;未知｜關 Module 失敗時實際的錯誤碼，重試是否有效&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;實驗中沒有出現過這個情況&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="925" y="1700" width="860" height="66" /></mxCell></root></mxGraphModel></diagram><diagram id="iccard" name="03｜iccard 的 use case"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="iccard-1" value="&lt;b&gt;iccard localserver｜use case（提案，尚未實作）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="iccard-2" value="每個 use case 一段。用卡的細節與六種結果見「02｜共用規則與卡片資源」，這裡只畫該 use case 特有的部分。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="iccard-3" value="白板 V10｜2026-11-20" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="18" width="250" height="52" /></mxCell><mxCell id="iccard-4" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-5" value="&lt;b&gt;命令&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="152" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-6" value="&lt;b&gt;流程步驟&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="274" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-7" value="&lt;b&gt;設備／外部&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="396" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-8" value="&lt;b&gt;業務事件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="518" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-9" value="&lt;b&gt;設備紀錄&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-10" value="&lt;b&gt;回應結果&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="762" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-11" value="&lt;b&gt;狀態&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="884" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-12" value="&lt;b&gt;不變量&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#c2aeea;" vertex="1" parent="1"><mxGeometry as="geometry" x="1006" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-13" value="&lt;b&gt;每當…就…&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1128" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-14" value="&lt;b&gt;已確認&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-15" value="&lt;b&gt;條件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1372" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-16" value="&lt;b&gt;驗收&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="1494" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-17" value="&lt;b&gt;待釐清&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1616" y="124" width="113" height="42" /></mxCell><mxCell id="iccard-18" value="&lt;b&gt;UC-I1｜驗卡（輸入 PIN，開始使用實體卡簽章）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="190" width="1700" height="34" /></mxCell><mxCell id="iccard-19" value="&lt;b&gt;醫師&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;輸入 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="230" width="220" height="86" /></mxCell><mxCell id="iccard-20" value="&lt;b&gt;驗卡&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="285" y="230" width="260" height="86" /></mxCell><mxCell id="iccard-21" value="&lt;b&gt;用卡一次（見 02）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;一次持鎖取憑證序號與卡片資料（現在是連續兩輪開關）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="230" width="330" height="86" /></mxCell><mxCell id="iccard-22" value="&lt;b&gt;實體卡簽章情境已建立&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;既有：行程內記住 PIN 與憑證序號，到期即撤銷。本設計加記卡號（已決議 F）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="945" y="230" width="300" height="86" /></mxCell><mxCell id="iccard-23" value="&lt;b&gt;完成&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;可以開始開立處方&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="230" width="300" height="86" /></mxCell><mxCell id="iccard-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-19" target="iccard-20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-20" target="iccard-21"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-21" target="iccard-22"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-22" target="iccard-23"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-28" value="&lt;b&gt;登入回 9039〔W15、W19〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;驗卡時無法分辨是 PIN 打錯，還是卡片被佔用&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="334" width="400" height="86" /></mxCell><mxCell id="iccard-29" value="&lt;b&gt;登入失敗（9039）；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="334" width="560" height="86" /></mxCell><mxCell id="iccard-30" value="&lt;b&gt;PIN 錯誤，或卡片被其他程式佔用&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;兩種可能都要提示：請先結束電子病歷簽章；確定 PIN 沒打錯時不要重打。不自動重試；簽章情境不建立。提示文字待決 N&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="334" width="680" height="86" /></mxCell><mxCell id="iccard-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-28" target="iccard-29"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-29" target="iccard-30"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-33" value="&lt;b&gt;登入回 9041&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;PIN 長度不符。9043 已鎖卡見 02 頁共用結果&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="436" width="400" height="66" /></mxCell><mxCell id="iccard-34" value="&lt;b&gt;登入失敗（9041）；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="436" width="560" height="66" /></mxCell><mxCell id="iccard-35" value="&lt;b&gt;用卡失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;顯示錯誤，不自動重試；簽章情境不建立&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="436" width="680" height="66" /></mxCell><mxCell id="iccard-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-33" target="iccard-34"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-34" target="iccard-35"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-38" value="&lt;b&gt;UC-I2｜開立處方簽章&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="546" width="1700" height="34" /></mxCell><mxCell id="iccard-39" value="&lt;b&gt;醫師&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;開立電子處方&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="586" width="170" height="110" /></mxCell><mxCell id="iccard-40" value="&lt;b&gt;簽一張處方&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="235" y="586" width="200" height="110" /></mxCell><mxCell id="iccard-41" value="&lt;b&gt;用卡一次（見 02）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;比對卡號 → 登入 → 讀憑證 → 取金鑰 → 簽章；約 2.7 秒&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="586" width="320" height="110" /></mxCell><mxCell id="iccard-42" value="&lt;b&gt;簽章值已取得&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;連同憑證序號；只在記憶體&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="825" y="586" width="250" height="110" /></mxCell><mxCell id="iccard-43" value="&lt;b&gt;鎖外｜iccard 產生 QR Code〔W9〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;用簽章值加密、拆分、產生影像；不碰卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="1110" y="586" width="290" height="110" /></mxCell><mxCell id="iccard-44" value="&lt;b&gt;完成｜QR Code 已產生&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;由 iccard 回傳給呼叫端&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1435" y="586" width="280" height="110" /></mxCell><mxCell id="iccard-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-39" target="iccard-40"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-46" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-40" target="iccard-41"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-41" target="iccard-42"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-42" target="iccard-43"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-43" target="iccard-44"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-50" value="&lt;b&gt;簽章情境已到期，或尚未設定〔P12〕&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="714" width="400" height="66" /></mxCell><mxCell id="iccard-51" value="&lt;b&gt;未取鎖；未呼叫 DLL&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="714" width="560" height="66" /></mxCell><mxCell id="iccard-52" value="&lt;b&gt;尚未設定簽章方式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;既有行為，本設計不改。回到 UC-I1；和「卡片不符」是不同的結果&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="714" width="680" height="66" /></mxCell><mxCell id="iccard-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-50" target="iccard-51"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-51" target="iccard-52"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-55" value="&lt;b&gt;卡號與驗卡時不同&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="796" width="400" height="66" /></mxCell><mxCell id="iccard-56" value="&lt;b&gt;未送出 PIN；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="796" width="560" height="66" /></mxCell><mxCell id="iccard-57" value="&lt;b&gt;卡片不符&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;回到 UC-I1 重新驗卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="796" width="680" height="66" /></mxCell><mxCell id="iccard-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-55" target="iccard-56"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-56" target="iccard-57"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-60" value="&lt;b&gt;登入回 9039〔W6、W19〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;PIN 先前已驗證過，卡號也相符&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="878" width="400" height="86" /></mxCell><mxCell id="iccard-61" value="&lt;b&gt;登入失敗（9039）；Module 已關閉；鎖已釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="878" width="560" height="86" /></mxCell><mxCell id="iccard-62" value="&lt;b&gt;卡片可能被其他程式佔用&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;已決議 J：簽章情境撤銷，不再自動送 PIN；提示先結束電子病歷簽章，再回 UC-I1 重新驗卡。提示文字待決 N&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="878" width="680" height="86" /></mxCell><mxCell id="iccard-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-60" target="iccard-61"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-61" target="iccard-62"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-65" value="&lt;b&gt;HCAAPI 正在用卡&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;對方是新版，有取鎖&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="980" width="400" height="66" /></mxCell><mxCell id="iccard-66" value="&lt;b&gt;未呼叫 DLL；未送出 PIN&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="980" width="560" height="66" /></mxCell><mxCell id="iccard-67" value="&lt;b&gt;卡片使用中&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;醫師稍後重開處方&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="980" width="680" height="66" /></mxCell><mxCell id="iccard-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-65" target="iccard-66"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-69" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-66" target="iccard-67"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-70" value="&lt;b&gt;簽章已取得，但關 Module 失敗&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1062" width="400" height="66" /></mxCell><mxCell id="iccard-71" value="&lt;b&gt;Module 未確認關閉；鎖未釋放&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="1062" width="560" height="66" /></mxCell><mxCell id="iccard-72" value="&lt;b&gt;完成｜QR Code 已產生&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;已取得的簽章照常使用並回傳，不重簽&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="1062" width="680" height="66" /></mxCell><mxCell id="iccard-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-70" target="iccard-71"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-74" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="iccard-71" target="iccard-72"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="iccard-75" value="&lt;b&gt;既有｜簽章情境的期限〔P12〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;到期時間由驗卡流程決定（spec 022 的範圍），到期時清除 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1158" width="420" height="110" /></mxCell><mxCell id="iccard-76" value="&lt;b&gt;一致性｜簽章是同步取得的&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;結果不是簽章值就是錯誤碼；重簽沒有副作用&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="485" y="1158" width="420" height="110" /></mxCell><mxCell id="iccard-77" value="&lt;b&gt;iccard 這一段沒有業務事件〔W5〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;iccard 用簽章值產生 QR Code 後回傳，本機不寫資料庫。「處方已簽章」由呼叫端的系統記錄，不在這張白板內&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="1158" width="420" height="110" /></mxCell><mxCell id="iccard-78" value="&lt;b&gt;已決議 F｜卡號比對納入，與 J 一起上版〔W16〕&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;現在記的是憑證序號，要登入後才讀得到，不能拿來擋 PIN。卡號不需 PIN 就能讀&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1395" y="1158" width="420" height="110" /></mxCell><mxCell id="iccard-79" value="&lt;b&gt;不碰卡、不取鎖&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1312" width="1700" height="34" /></mxCell><mxCell id="iccard-80" value="&lt;b&gt;調劑端驗章&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;只用憑證驗章&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1352" width="400" height="66" /></mxCell><mxCell id="iccard-81" value="&lt;b&gt;行動憑證簽章&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不經過實體卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="1352" width="400" height="66" /></mxCell></root></mxGraphModel></diagram><diagram id="hcaapi" name="04｜HCAAPI 的 use case"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hcaapi-1" value="&lt;b&gt;HCAAPI localserver｜use case（提案，尚未實作）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="hcaapi-2" value="醫師在 UI 按「開始簽章」後，UI 定期呼叫 HCAAPI。整個 callAPI 一次只處理一個指令。用卡細節見「02｜共用規則與卡片資源」。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="hcaapi-3" value="白板 V10｜2026-11-20" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1500" y="18" width="250" height="52" /></mxCell><mxCell id="hcaapi-4" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-5" value="&lt;b&gt;命令&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="152" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-6" value="&lt;b&gt;流程步驟&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ece6da;" vertex="1" parent="1"><mxGeometry as="geometry" x="274" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-7" value="&lt;b&gt;設備／外部&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="396" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-8" value="&lt;b&gt;業務事件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="518" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-9" value="&lt;b&gt;設備紀錄&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#bfe3e0;" vertex="1" parent="1"><mxGeometry as="geometry" x="640" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-10" value="&lt;b&gt;回應結果&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff4b8;" vertex="1" parent="1"><mxGeometry as="geometry" x="762" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-11" value="&lt;b&gt;狀態&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#d3daf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="884" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-12" value="&lt;b&gt;不變量&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#c2aeea;" vertex="1" parent="1"><mxGeometry as="geometry" x="1006" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-13" value="&lt;b&gt;每當…就…&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1128" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-14" value="&lt;b&gt;已確認&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1250" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-15" value="&lt;b&gt;條件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1372" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-16" value="&lt;b&gt;驗收&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e2efbf;" vertex="1" parent="1"><mxGeometry as="geometry" x="1494" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-17" value="&lt;b&gt;待釐清&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1616" y="124" width="113" height="42" /></mxCell><mxCell id="hcaapi-18" value="&lt;b&gt;UC-H1｜初始化（initialize）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="190" width="1700" height="34" /></mxCell><mxCell id="hcaapi-19" value="&lt;b&gt;醫師&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;按「開始簽章」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="230" width="200" height="86" /></mxCell><mxCell id="hcaapi-20" value="&lt;b&gt;initialize&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;帶 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="265" y="230" width="220" height="86" /></mxCell><mxCell id="hcaapi-21" value="&lt;b&gt;用卡一次（見 02）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;讀卡號 → 登入 → 取公私鑰確認可用。之後不再握著 Session&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strok