<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net" compressed="false" pages="3"><diagram id="current" name="01｜現況與實驗事實"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="current-1" value="&lt;b&gt;同機共用醫事人員卡｜現況與實驗事實&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="current-2" value="範圍：一般讀卡機 PC/SC。不含 HCAAPI 的 NHI 模式、iccard 的 HCA_CLI 模式。兩支程式都由這台電腦的使用者本人操作觸發，沒有排程。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="current-3" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="124" width="150" height="42" /></mxCell><mxCell id="current-4" value="&lt;b&gt;命令&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="195" y="124" width="150" height="42" /></mxCell><mxCell id="current-5" value="&lt;b&gt;設備／外部&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="124" width="150" height="42" /></mxCell><mxCell id="current-6" value="&lt;b&gt;結果事實&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="525" y="124" width="150" height="42" /></mxCell><mxCell id="current-7" value="&lt;b&gt;規則&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="124" width="150" height="42" /></mxCell><mxCell id="current-8" value="&lt;b&gt;已確認&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="855" y="124" width="150" height="42" /></mxCell><mxCell id="current-9" value="&lt;b&gt;條件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="124" width="150" height="42" /></mxCell><mxCell id="current-10" value="&lt;b&gt;待釐清／風險&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1185" y="124" width="150" height="42" /></mxCell><mxCell id="current-11" value="&lt;b&gt;iccard localserver｜電子處方箋&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="190" width="1700" height="34" /></mxCell><mxCell id="current-12" value="&lt;b&gt;醫師&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;開立電子處方&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="230" width="260" height="86" /></mxCell><mxCell id="current-13" value="&lt;b&gt;簽一張處方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;驗卡時另有取憑證序號、取卡片資料&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="325" y="230" width="300" height="86" /></mxCell><mxCell id="current-14" value="&lt;b&gt;HCA DLL／讀卡機／卡片&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每次操作自開自關，約 2.7 秒&lt;br&gt;jar 版本 1,0,12,410&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="230" width="380" height="86" /></mxCell><mxCell id="current-15" value="&lt;b&gt;處方簽章已取得&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;或：某一步失敗，直接拋錯&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="1075" y="230" width="330" height="86" /></mxCell><mxCell id="current-16" value="&lt;b&gt;失敗時沒有關 Session 與 Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;回傳碼沒檢查；清理拋例外時會丟掉已取得的簽章&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440" y="230" width="330" height="86" /></mxCell><mxCell id="current-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-12" target="current-13"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-13" target="current-14"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-14" target="current-15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-15" target="current-16"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-21" value="&lt;b&gt;HCAAPI localserver｜電子病歷&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="350" width="1700" height="34" /></mxCell><mxCell id="current-22" value="&lt;b&gt;醫師&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;在 UI 按「開始簽章」，UI 之後定期呼叫&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="390" width="260" height="86" /></mxCell><mxCell id="current-23" value="&lt;b&gt;initialize → makeSignature&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;分開的指令；指令不帶 handle&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="325" y="390" width="300" height="86" /></mxCell><mxCell id="current-24" value="&lt;b&gt;HCA DLL／讀卡機／卡片&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Session 從 initialize 握到 closeModule&lt;br&gt;jar 版本 1,0,10,1208&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="390" width="380" height="86" /></mxCell><mxCell id="current-25" value="&lt;b&gt;文件逐份簽章並保存&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每份：雜湊、簽章、時戳、上傳、回寫資料庫&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="1075" y="390" width="330" height="86" /></mxCell><mxCell id="current-26" value="&lt;b&gt;狀態全在 static 欄位，沒有同步&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;關閉回錯誤時 handle 不清零，之後初始化持續失敗&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1440" y="390" width="330" height="86" /></mxCell><mxCell id="current-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-22" target="current-23"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-23" target="current-24"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-24" target="current-25"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="current-25" target="current-26"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="current-31" value="&lt;b&gt;已解決，與本題分開&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="520" width="1700" height="34" /></mxCell><mxCell id="current-32" value="&lt;b&gt;DLL 檔案衝突已排除&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;iccard 把原生檔解到自己的目錄；實機確認兩支程式可以任意順序啟動&lt;br&gt;已提交，待上版。這只解決檔案衝突，不解決卡片互斥&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="560" width="820" height="86" /></mxCell><mxCell id="current-33" value="&lt;b&gt;實驗觀察（一台電腦、一台讀卡機、一張卡，三輪）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="690" width="1700" height="34" /></mxCell><mxCell id="current-34" value="&lt;b&gt;兩個行程可以同時開 Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;三輪都成功&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="730" width="320" height="106" /></mxCell><mxCell id="current-35" value="&lt;b&gt;一方登入中，另一方登入失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;HCAAPI 去試：9062（一次）&lt;br&gt;iccard 去試：9039 PIN 錯誤（兩次，PIN 無誤）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="385" y="730" width="320" height="106" /></mxCell><mxCell id="current-36" value="&lt;b&gt;登入失敗後，對方仍能簽章&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;一次&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="740" y="730" width="320" height="106" /></mxCell><mxCell id="current-37" value="&lt;b&gt;一方關 Module 後，另一方下次簽章失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;9016（拆開步驟的只有一次）&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1095" y="730" width="320" height="106" /></mxCell><mxCell id="current-38" value="&lt;b&gt;登入失敗後，同一個 Module 要重開&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;之後一律 9046&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1450" y="730" width="320" height="106" /></mxCell><mxCell id="current-39" value="&lt;b&gt;未知｜9039 會不會扣 PIN 次數&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;驗證要連錯三次，有鎖卡風險，沒有做&lt;br&gt;設計上一律當成會扣&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="866" width="400" height="86" /></mxCell><mxCell id="current-40" value="&lt;b&gt;未知｜行程當掉後卡片的狀態&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;下一個行程能否正常登入，沒有測過&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="465" y="866" width="400" height="86" /></mxCell><mxCell id="current-41" value="&lt;b&gt;未知｜關 Module 為何影響對方&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;耗時是平常的五倍，原因沒有證據&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="866" width="400" height="86" /></mxCell><mxCell id="current-42" value="&lt;b&gt;未測｜iccard 簽章中遇到 checkHCAAPI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;它不登入但會開關 Module，依上面的觀察推論會出事&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1335" y="866" width="400" height="86" /></mxCell></root></mxGraphModel></diagram><diagram id="target" name="02｜目標流程"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="target-1" value="&lt;b&gt;同機共用醫事人員卡｜目標流程（提案，尚未實作）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="target-2" value="每一列是同一個命令的一種結果。「拿到簽章」和「卡片資源可以交給對方」是兩件事，分開看。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="target-3" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="124" width="150" height="42" /></mxCell><mxCell id="target-4" value="&lt;b&gt;命令&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="195" y="124" width="150" height="42" /></mxCell><mxCell id="target-5" value="&lt;b&gt;設備／外部&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="124" width="150" height="42" /></mxCell><mxCell id="target-6" value="&lt;b&gt;結果事實&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="525" y="124" width="150" height="42" /></mxCell><mxCell id="target-7" value="&lt;b&gt;規則&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="124" width="150" height="42" /></mxCell><mxCell id="target-8" value="&lt;b&gt;已確認&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="855" y="124" width="150" height="42" /></mxCell><mxCell id="target-9" value="&lt;b&gt;條件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="124" width="150" height="42" /></mxCell><mxCell id="target-10" value="&lt;b&gt;待釐清／風險&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1185" y="124" width="150" height="42" /></mxCell><mxCell id="target-11" value="&lt;b&gt;規則 1｜先取得鎖，才能開 Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;鎖從 InitModule 之前護到 CloseModule 之後&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="190" width="560" height="66" /></mxCell><mxCell id="target-12" value="&lt;b&gt;規則 2｜Module 確認關閉，才能放鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;持鎖的意思是「我可能還有 Module 開著」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="190" width="560" height="66" /></mxCell><mxCell id="target-13" value="&lt;b&gt;規則 3｜對方可能持卡時，不送 PIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;取鎖後先讀卡號比對，不符也不送 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="190" width="560" height="66" /></mxCell><mxCell id="target-14" value="&lt;b&gt;用一次卡（iccard 簽一張處方；HCAAPI 的每個用卡指令也走同一套）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="296" width="1700" height="34" /></mxCell><mxCell id="target-15" value="&lt;b&gt;醫師&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;開立處方，或按「開始簽章」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="336" width="220" height="66" /></mxCell><mxCell id="target-16" value="&lt;b&gt;用一次卡&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;由使用者操作同步觸發&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="285" y="336" width="250" height="66" /></mxCell><mxCell id="target-17" value="&lt;b&gt;取鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;最多等 15 秒&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="336" width="250" height="66" /></mxCell><mxCell id="target-18" value="&lt;b&gt;開 Module → 讀卡號比對 → 登入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;→ 讀憑證、取金鑰、簽章&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="855" y="336" width="330" height="66" /></mxCell><mxCell id="target-19" value="&lt;b&gt;關 Session → 關 Module&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;兩個都做，都檢查回傳碼&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="336" width="300" height="66" /></mxCell><mxCell id="target-20" value="&lt;b&gt;放鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;只有關 Module 成功時&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1555" y="336" width="250" height="66" /></mxCell><mxCell id="target-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-15" target="target-16"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-16" target="target-17"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-17" target="target-18"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-18" target="target-19"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-19" target="target-20"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-26" value="&lt;b&gt;一切正常&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="442" width="380" height="66" /></mxCell><mxCell id="target-27" value="&lt;b&gt;簽章已取得，鎖已釋放&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;對方可以立刻用卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="442" width="460" height="66" /></mxCell><mxCell id="target-28" value="&lt;b&gt;回傳簽章&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="442" width="780" height="66" /></mxCell><mxCell id="target-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-26" target="target-27"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-27" target="target-28"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-31" value="&lt;b&gt;15 秒內等不到鎖&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="526" width="380" height="66" /></mxCell><mxCell id="target-32" value="&lt;b&gt;本次沒有碰卡&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;沒有呼叫 DLL，沒有送 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="526" width="460" height="66" /></mxCell><mxCell id="target-33" value="&lt;b&gt;回報「卡片使用中」&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;顯示佔用者；由使用者重試，程式不自動重試&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="526" width="780" height="66" /></mxCell><mxCell id="target-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-31" target="target-32"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-32" target="target-33"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-36" value="&lt;b&gt;鎖檔無法建立或開啟&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="610" width="380" height="66" /></mxCell><mxCell id="target-37" value="&lt;b&gt;本次沒有碰卡&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="610" width="460" height="66" /></mxCell><mxCell id="target-38" value="&lt;b&gt;拒絕用卡，不繞過&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;提示聯絡資訊室&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="610" width="780" height="66" /></mxCell><mxCell id="target-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-36" target="target-37"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-37" target="target-38"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-41" value="&lt;b&gt;卡號與預期不符&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="694" width="380" height="66" /></mxCell><mxCell id="target-42" value="&lt;b&gt;沒有送出 PIN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;已清理，鎖已釋放&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="694" width="460" height="66" /></mxCell><mxCell id="target-43" value="&lt;b&gt;要求重新驗卡或重新初始化&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="694" width="780" height="66" /></mxCell><mxCell id="target-44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-41" target="target-42"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-42" target="target-43"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-46" value="&lt;b&gt;DLL 回錯誤碼&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="778" width="380" height="66" /></mxCell><mxCell id="target-47" value="&lt;b&gt;本次失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;已清理，鎖已釋放&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="778" width="460" height="66" /></mxCell><mxCell id="target-48" value="&lt;b&gt;回報錯誤碼&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;PIN 類錯誤（9039、9041、9043）不重試&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="778" width="780" height="66" /></mxCell><mxCell id="target-49" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-46" target="target-47"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-50" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-47" target="target-48"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-51" value="&lt;b&gt;簽章已取得，但關 Module 失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;重試三次仍失敗&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="862" width="380" height="66" /></mxCell><mxCell id="target-52" value="&lt;b&gt;簽章已取得；鎖沒有釋放&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;本行程進入「卡片資源異常」&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="862" width="460" height="66" /></mxCell><mxCell id="target-53" value="&lt;b&gt;簽章照常回傳，不重簽&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;下次用卡先再試關閉；仍失敗就提示重啟程式。對方逾時並看到佔用者&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="862" width="780" height="66" /></mxCell><mxCell id="target-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-51" target="target-52"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-52" target="target-53"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-56" value="&lt;b&gt;HCAAPI 批次簽章（makeSignature）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="972" width="1700" height="34" /></mxCell><mxCell id="target-57" value="&lt;b&gt;makeSignature&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;先確認初始化狀態還在&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1012" width="250" height="66" /></mxCell><mxCell id="target-58" value="&lt;b&gt;取鎖&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="315" y="1012" width="200" height="66" /></mxCell><mxCell id="target-59" value="&lt;b&gt;鎖內｜整批取完簽章&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;開 → 比對卡號 → 登入 → 逐份雜湊、簽章 → 關&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="1012" width="420" height="66" /></mxCell><mxCell id="target-60" value="&lt;b&gt;放鎖&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1005" y="1012" width="200" height="66" /></mxCell><mxCell id="target-61" value="&lt;b&gt;鎖外｜逐份保存&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;時戳、組 XML 上傳、確認、回寫資料庫&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1240" y="1012" width="400" height="66" /></mxCell><mxCell id="target-62" value="&lt;b&gt;文件已保存&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="1675" y="1012" width="240" height="66" /></mxCell><mxCell id="target-63" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-57" target="target-58"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-58" target="target-59"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-65" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-59" target="target-60"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-66" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-60" target="target-61"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-61" target="target-62"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-68" value="&lt;b&gt;第 N 份簽章失敗&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1096" width="380" height="66" /></mxCell><mxCell id="target-69" value="&lt;b&gt;前 N−1 份簽章已取得&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;已清理，鎖已釋放&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="1096" width="460" height="66" /></mxCell><mxCell id="target-70" value="&lt;b&gt;前 N−1 份照常保存；第 N 份起回報失敗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;結果與現在逐份處理相同&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="1096" width="780" height="66" /></mxCell><mxCell id="target-71" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-68" target="target-69"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-69" target="target-70"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-73" value="&lt;b&gt;第 M 份保存失敗&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1180" width="380" height="66" /></mxCell><mxCell id="target-74" value="&lt;b&gt;前 M−1 份已保存&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;其餘簽章只在記憶體&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="445" y="1180" width="460" height="66" /></mxCell><mxCell id="target-75" value="&lt;b&gt;未保存的簽章直接丟棄，使用者重新簽章&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;重簽沒有副作用&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="940" y="1180" width="780" height="66" /></mxCell><mxCell id="target-76" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-73" target="target-74"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#61756b;strokeWidth=2;" edge="1" parent="1" source="target-74" target="target-75"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="target-78" value="&lt;b&gt;整批文件同時留在記憶體&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;32 位元 JVM；現行程式本來就有多處記憶體不足的防護&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="1276" width="560" height="66" /></mxCell><mxCell id="target-79" value="&lt;b&gt;整批持鎖可能超過對方的 15 秒&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每份約 1 秒以上；批次大時開處方會逾時&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="625" y="1276" width="560" height="66" /></mxCell><mxCell id="target-80" value="&lt;b&gt;對策｜分段&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每段 K 份：簽一段、放鎖、保存一段。先量測再定 K&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1276" width="560" height="66" /></mxCell></root></mxGraphModel></diagram><diagram id="decide" name="03｜決議、待決與驗收"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1400" background="#f8f9f6" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="decide-1" value="&lt;b&gt;同機共用醫事人員卡｜決議、待決與驗收&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=32;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="18" width="1700" height="52" /></mxCell><mxCell id="decide-2" value="對應設計文件 docs/hca-card-mutex-design.md 第 6～10 節。" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1700" height="44" /></mxCell><mxCell id="decide-3" value="&lt;b&gt;角色&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#fff094;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="124" width="150" height="42" /></mxCell><mxCell id="decide-4" value="&lt;b&gt;命令&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="195" y="124" width="150" height="42" /></mxCell><mxCell id="decide-5" value="&lt;b&gt;設備／外部&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#f4cce5;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="124" width="150" height="42" /></mxCell><mxCell id="decide-6" value="&lt;b&gt;結果事實&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffc18e;" vertex="1" parent="1"><mxGeometry as="geometry" x="525" y="124" width="150" height="42" /></mxCell><mxCell id="decide-7" value="&lt;b&gt;規則&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="690" y="124" width="150" height="42" /></mxCell><mxCell id="decide-8" value="&lt;b&gt;已確認&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="855" y="124" width="150" height="42" /></mxCell><mxCell id="decide-9" value="&lt;b&gt;條件&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#e5e9ec;" vertex="1" parent="1"><mxGeometry as="geometry" x="1020" y="124" width="150" height="42" /></mxCell><mxCell id="decide-10" value="&lt;b&gt;待釐清／風險&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1185" y="124" width="150" height="42" /></mxCell><mxCell id="decide-11" value="&lt;b&gt;已決議（2026-11-19 review）&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="190" width="1700" height="34" /></mxCell><mxCell id="decide-12" value="&lt;b&gt;修改 HCAAPI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每個用卡指令自開自關並加鎖；不再握著 Session&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="230" width="410" height="66" /></mxCell><mxCell id="decide-13" value="&lt;b&gt;不另做共享的「暫停狀態」&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Module 沒確認關閉就不放鎖，鎖本身就是訊號&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="230" width="410" height="66" /></mxCell><mxCell id="decide-14" value="&lt;b&gt;HCAAPI 的 callAPI 整體序列化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;第一版前提。鎖的順序：callAPI 鎖 → 卡片鎖&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="230" width="410" height="66" /></mxCell><mxCell id="decide-15" value="&lt;b&gt;批次簽章：鎖內簽完，鎖外保存&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="230" width="410" height="66" /></mxCell><mxCell id="decide-16" value="&lt;b&gt;鎖檔失敗就拒絕用卡&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;不繞過&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="320" width="410" height="86" /></mxCell><mxCell id="decide-17" value="&lt;b&gt;等不到鎖就回報使用者&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;沒有排程，程式不自動重試&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="320" width="410" height="86" /></mxCell><mxCell id="decide-18" value="&lt;b&gt;iccard 先上版，HCAAPI 後上&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;混版不保證互斥，也不保證行為沒有退化&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="320" width="410" height="86" /></mxCell><mxCell id="decide-19" value="&lt;b&gt;HCAAPI 的初始化狀態&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;改為不可變物件：使用者、PIN、卡號；不再用 handle 代表已初始化&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#cfe9c9;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="320" width="410" height="86" /></mxCell><mxCell id="decide-20" value="&lt;b&gt;待決&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="450" width="1700" height="34" /></mxCell><mxCell id="decide-21" value="&lt;b&gt;A｜等待上限&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議兩邊 15 秒，量測後調整&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="490" width="410" height="66" /></mxCell><mxCell id="decide-22" value="&lt;b&gt;B｜批次分段大小 K&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議第一版整批，依量測決定是否設上限&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="490" width="410" height="66" /></mxCell><mxCell id="decide-23" value="&lt;b&gt;C｜鎖檔路徑&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議 C:\opdsysora\newHis\hca-card.lock&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="490" width="410" height="66" /></mxCell><mxCell id="decide-24" value="&lt;b&gt;D｜checkHCAAPI 要不要作廢初始化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;現在會；建議不作廢，需前端確認&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="490" width="410" height="66" /></mxCell><mxCell id="decide-25" value="&lt;b&gt;E｜updateCardinfo 之後能否直接簽章&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;現在可以，但用的是舊的金鑰 handle；建議視為重新初始化&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="580" width="410" height="86" /></mxCell><mxCell id="decide-26" value="&lt;b&gt;F｜iccard 的卡號比對是否納入第一版&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議納入；讀卡號不需要 PIN&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="580" width="410" height="86" /></mxCell><mxCell id="decide-27" value="&lt;b&gt;G｜要不要做行程中止實驗&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;建議做一次：握住 Session 後強制結束，另一方登入一次&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="580" width="410" height="86" /></mxCell><mxCell id="decide-28" value="&lt;b&gt;驗收&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#172722;fontSize=23;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="710" width="1700" height="34" /></mxCell><mxCell id="decide-29" value="&lt;b&gt;T1｜兩個 JVM 搶鎖&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A 在鎖內時 B 等待且沒有碰 DLL；A 放鎖後 B 取得。交換角色&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="750" width="410" height="106" /></mxCell><mxCell id="decide-30" value="&lt;b&gt;T2｜清理與結果分開（假 DLL）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;關 Session 失敗仍會關 Module&lt;br&gt;先回簽章再讓關 Module 失敗：只簽一次、簽章有回傳、鎖沒放&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="750" width="410" height="106" /></mxCell><mxCell id="decide-31" value="&lt;b&gt;T3｜不送 PIN 的情況&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;卡號不符、等不到鎖、鎖檔失敗：都沒有呼叫 InitSession&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="750" width="410" height="106" /></mxCell><mxCell id="decide-32" value="&lt;b&gt;T4｜POC 加鎖後重跑 E1～E3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;預期不再出現 9039、9062、9016，簽章全部驗章通過&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="750" width="410" height="106" /></mxCell><mxCell id="decide-33" value="&lt;b&gt;T5｜正式程式實機&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;已初始化時開處方；批次的鎖內與保存階段各開一次處方；換卡後簽章；批次中途拔卡&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="880" width="410" height="86" /></mxCell><mxCell id="decide-34" value="&lt;b&gt;T6｜量測&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;批次每份在鎖內的耗時、整批記憶體用量&lt;br&gt;用來決定 A 與 B&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#addef7;" vertex="1" parent="1"><mxGeometry as="geometry" x="475" y="880" width="410" height="86" /></mxCell><mxCell id="decide-35" value="&lt;b&gt;上線條件&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;兩邊同一個鎖檔與規則；所有會開 Module 的入口都走共用流程；兩個執行帳號都能寫鎖檔&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#dfcdf6;" vertex="1" parent="1"><mxGeometry as="geometry" x="920" y="880" width="410" height="86" /></mxCell><mxCell id="decide-36" value="&lt;b&gt;HCAAPI 修改風險&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;HCAUtils 約三千行、全 static、沒有測試；批次兩階段化風險最高&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=8;spacingLeft=10;spacingRight=9;strokeColor=none;shadow=1;fontColor=#172722;fontSize=18;fillColor=#ffb9c5;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="880" width="410" height="86" /></mxCell></root></mxGraphModel></diagram></mxfile>
